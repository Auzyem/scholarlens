NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ANTHROPIC_API_KEY=your_anthropic_api_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs — create these in your Stripe dashboard
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_ANNUAL=price_...

# Shared secret for the sweep that fails stuck review sessions
# (/api/cron/reap-reviews). The caller sends it as `Authorization: Bearer <value>`;
# the scheduler is .github/workflows/reap-stuck-reviews.yml, NOT a Vercel cron
# (this account is on Hobby, which caps crons at once a day). The same value must
# be set in the Vercel Production env AND the repo's Actions secrets.
# The route fails closed if this is unset. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Error monitoring (Sentry) -----------------------------------------------
# All optional: an absent DSN disables Sentry entirely, and the build must pass
# without any of these (CI sets none of them).
# The DSN is public by design — it ships in the client bundle, and it permits
# sending events, not reading them.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source-map upload. NEVER prefix with NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
